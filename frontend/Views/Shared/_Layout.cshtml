@{
    var isLogin = ViewContext.RouteData.Values["controller"]?.ToString() == "Account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1220" />
    <title>@ViewData["Title"] · SDALS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="@(isLogin ? "login-page" : "")">
    @if (!isLogin)
    {
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark">S</span>
                <span><b>SDALS</b><small>SMART ACCESS CONTROL</small></span>
            </a>
            <div class="nav-caption">WORKSPACE</div>
            <a class="nav-link active" href="#overview"><span>◫</span> Overview</a>
            <a class="nav-link" href="#users"><span>♙</span> User management</a>
            <a class="nav-link" href="#credentials"><span>▤</span> Credentials</a>
            <a class="nav-link" href="#activity"><span>◷</span> Access activity</a>
            <div class="sidebar-bottom">
                <div class="system-mini"><span class="pulse"></span><span><b>Local system</b><small>Admin console</small></span></div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="logout-link" type="submit">↪ Sign out</button>
                </form>
            </div>
        </aside>
    }
    <main class="main-shell @(isLogin ? "main-login" : "")">
        @if (!isLogin)
        {
            <header class="topbar">
                <button class="mobile-menu" id="menuToggle" aria-label="Toggle navigation">☰</button>
                <div><span class="eyebrow">SMART DOOR ACCESS</span><h1>@ViewData["Title"]</h1></div>
                <div class="topbar-user"><span class="avatar">@(Context.Session.GetString("sdals_username")?.FirstOrDefault().ToString().ToUpper() ?? "A")</span><span><b>@Context.Session.GetString("sdals_username")</b><small>Administrator</small></span></div>
            </header>
        }
        @RenderBody()
        @if (!isLogin) { <footer class="page-footer">SDALS · Smart Door Access &amp; Logging System <span>Secure local administration</span></footer> }
    </main>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
